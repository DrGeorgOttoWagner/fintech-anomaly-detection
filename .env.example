# FTAD configuration (copy to .env; .env is git-ignored)
# Bind address and port — keep loopback for local-only operation.
FTAD_HOST=127.0.0.1
FTAD_PORT=8790
# Where uploads, experiments and reports are stored (default: FTAD/var).
# FTAD_DATA_DIR=./var
# Optional folder for one-click "Export to folder" of research reports.
# Reports are copied into <FTAD_EXPORT_DIR>/ftad_exports/. Leave empty to disable.
FTAD_EXPORT_DIR=
# Upload size limit in MB.
FTAD_MAX_UPLOAD_MB=1024
